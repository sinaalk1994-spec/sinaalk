@echo off
cd /d "%~dp0"
echo در حال روشن کردن سرور STLP ...
echo.
rem این عدد را بالاتر می‌بریم تا کارهای سنگین‌تر (مثل هش‌کردنِ رمز
rem عبور یا خواندن هم‌زمانِ چند فایل) بتوانند از هسته‌های بیشترِ
rem همین کامپیوتر به‌طور موازی استفاده کنند، نه اینکه پشتِ هم صف
rem بکشند. برای این برنامه (که کاربرهای همزمانش محدود است) عدد ۱۶
rem بیشتر از کافی است و هیچ عارضه‌ای ندارد.
set UV_THREADPOOL_SIZE=16
node server.js
echo.
echo سرور متوقف شد. (اگر با خطا مواجه شدید، همین پیام را برای بررسی نگه دارید)
pause
